# ─────────────────────────────────────────────
# NativeLingo .gitignore
# ─────────────────────────────────────────────

# ── macOS ──
.DS_Store
.AppleDouble
.LSOverride

# ── Python ──
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / frontend ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# ── Rust / Tauri ──
src-tauri/target/
src-tauri/gen/schemas/

# ── App runtime output & large media ──────────
# Reference videos are large binaries: kept on disk, kept out of git.
# Use Git LFS if you need them version-controlled.
videos/*.mp4
videos/*.mov
videos/*.mkv
videos/*.avi
videos/*.m4v
# Learner recordings / rendered audio produced at runtime
recordings/
*.aiff
# Calibration reference-TTS cache (rebuildable via scripts/build_calibration.py)
data/ref_tts_cache/
# LibriSpeech download used by scripts/quantify_ref_gap.py (re-downloadable)
data/librispeech/

# ── Build / distribution artifacts ─────────────
# Dedicated freeze venv (rebuilt by scripts/build_dmg.sh)
.venv-freeze/
# Pre-bundled ML models staged for the freeze (re-downloadable; not source).
# Anchored: unanchored `models/` also matched the Kotlin package directory
# `NativeLingoAndroid/core-models/src/*/kotlin/com/nativelingo/models/`, which
# silently kept all of :core-models out of git.
/models/
# Staged PyInstaller sidecar + bundled ffmpeg (produced by build_dmg.sh, not source)
src-tauri/resources/nativeLingoBackend/
src-tauri/resources/bin/

# Android bundled corpus — synced from ../videos at build time (see
# app/build.gradle.kts syncCorpus), not committed. 91 MiB; source of truth is videos/.
NativeLingoAndroid/app/src/main/assets/corpus/

# Android model asset pack — synced from build/onnx + sherpa at build time
# (see asset-pack-models/build.gradle.kts syncModels), not committed. 935 MiB.
NativeLingoAndroid/asset-pack-models/src/main/assets/

# Local dev tools (bundletool for AAB/asset-pack verification).
NativeLingoAndroid/.tools/

# ── Secrets / env ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Claude Code (local only) ──
# Shared .claude/settings.json may be committed; ignore the local override.
.claude/settings.local.json

# ── Editors ──
.vscode/
.idea/
*.swp
*~

# Cloud server variant (server/) — the ONNX weights are staged at deploy time
# from the same exports the Android build syncs (build/onnx + models/); not source.
/server/models/
/server/videos/
