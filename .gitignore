# ─────────────────────────────────────────────
# NativeLingo .gitignore
# ─────────────────────────────────────────────

# ── macOS ──
.DS_Store
.AppleDouble
.LSOverride

# ── Python ──
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.firecrawl/

# ── Node / frontend ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
desktop/test-results/
desktop/playwright-report/

# ── Rust / Tauri ──
desktop/src-tauri/target/
desktop/src-tauri/gen/schemas/

# ── App runtime output & large media ──────────
# Reference videos are large binaries: kept on disk, kept out of git.
# Use Git LFS if you need them version-controlled.
videos/*.mp4
videos/*.mov
videos/*.mkv
videos/*.avi
videos/*.m4v
# Learner recordings / rendered audio produced at runtime
recordings/
*.aiff
# Calibration reference-TTS cache (rebuildable via scripts/build_calibration.py)
data/ref_tts_cache/
# LibriSpeech download used by scripts/quantify_ref_gap.py (re-downloadable)
data/librispeech/

# ── Build / distribution artifacts ─────────────
# Dedicated freeze venv (rebuilt by scripts/build_dmg.sh)
.venv-freeze/
# Pre-bundled ML models staged for the freeze (re-downloadable; not source)
models/
# Staged PyInstaller sidecar + bundled ffmpeg (produced by build_dmg.sh, not source)
desktop/src-tauri/resources/nativeLingoBackend/
desktop/src-tauri/resources/bin/

# ── Android (separate platform branch; not part of the macOS line) ──
# The Android project lives on the `android` branch. Any local NativeLingoAndroid/
# working state — including the release keystore + its credentials — is irrelevant
# to `main` and must NEVER be added or deleted from here.
/NativeLingoAndroid/

# ── Secrets / env ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Claude Code (local only) ──
# Shared .claude/settings.json may be committed; ignore the local override.
.claude/settings.local.json
CLAUDE.md

# ── Editors ──
.vscode/
.idea/
*.swp
*~

# agent session state and editor backups
.zcode/
*.blend1

# Godot CSV auto-import creates per-column translation resources; these are derived build artifacts, not the licensed original files.
game/assets/wordlists/*.translation

# Local operator-provided TTS credentials; never commit. The
# game/speech_service/.gdignore keeps Godot from importing the CSV as a
# translation resource (the derived .translation embeds the key).
TTS.csv
TTS.csv.import
TTS.*.translation
XAI.csv
XAI.csv.import
XAI.xlsx
GEMINI.csv
GEMINI.csv.import
game/speech_service/*.xlsx

# Licensed-caption corpus work stays outside the Godot package and source tree.
# Only reviewed response-pattern JSON is promoted into game/data/dialogue/.
game/speech_service/corpus_work/
game/speech_service/raw_captions/
