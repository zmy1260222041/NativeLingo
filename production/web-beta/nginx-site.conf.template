# Stranger Web Beta — Nginx site template.
# Replace ${DOMAIN} via envsubst before installing on the server.
# Single-thread Godot Web export: NO COOP/COEP headers (threads/PWA are off).

server {
    listen 80;
    listen [::]:80;
    server_name beta.${DOMAIN};

    # ACME HTTP-01 challenges (certbot uses the webroot plugin when told to).
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name beta.${DOMAIN};

    root /srv/nativelingo/current;
    index index.html;

    # ------------------------------------------------------------------
    # TLS (certbot-managed files). A-grade target: TLS 1.2+, modern ciphers.
    # ------------------------------------------------------------------
    ssl_certificate     /etc/letsencrypt/live/beta.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/beta.${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # ------------------------------------------------------------------
    # Access control: every tester has an anonymous alias + bcrypt password.
    # The htpasswd file lives outside release dirs and is managed by
    # production/web-beta/accounts.sh (never committed).
    # ------------------------------------------------------------------
    auth_basic "Stranger Web Beta";
    auth_basic_user_file /srv/nativelingo/accounts.htpasswd;

    # ------------------------------------------------------------------
    # Logging: account, time, IP, UA, status. Rotated by nginx logrotate
    # (production/web-beta/nginx-logrotate.conf), 30 days retention.
    # ------------------------------------------------------------------
    log_format nativelingo '$remote_user - $remote_addr [$time_local] '
                           '"$request" $status $body_bytes_sent '
                           '"$http_user_agent"';
    access_log /var/log/nginx/nativelingo_access.log nativelingo;
    error_log  /var/log/nginx/nativelingo_error.log warn;

    # ------------------------------------------------------------------
    # Security headers. microphone=() is the hard browser-side guarantee
    # that this build never asks for the mic.
    # ------------------------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; media-src 'self' blob:; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Correct WASM MIME type; Godot 4.6 exports index.wasm.
    types {
        text/html   html;
        application/javascript js;
        application/wasm wasm;
        application/octet-stream pck;
        image/png   png;
        image/svg+xml svg;
    }

    gzip_static on;
    gzip_vary on;

    # Home page is never cached so auth changes / rollbacks take effect.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location = /index.js {
        add_header Cache-Control "public, max-age=3600";
    }

    location ~* \.wasm$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.pck$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(png|jpg|svg|ico)$ {
        add_header Cache-Control "public, max-age=86400";
    }

    location = /SHA256SUMS {
        add_header Cache-Control "no-store";
    }

    location = /build-info.json {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
