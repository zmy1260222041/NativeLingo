      "hit": [
        "Always slow on Mondays, yes. I come here for my mother. And you, first time?",
        "Half an hour at least. I bring a book now. Have you been to this clinic before?"
      ],
      "partial": [
        "Sorry, was that a question for me?",
        "I think you asked something. Say it again?"
      ],
      "miss": [
        "Sorry, say that again?",
        "Hmm? I did not catch that."
      ]
    }
  },
